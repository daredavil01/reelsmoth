{
  "name": "reelsmith",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Video Studio: turn web content into polished videos with Claude Code and Remotion.",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-timeline.ts src/compositions/*.timeline.json $(ls videos/*/timeline.json 2>/dev/null)",
    "demo": "bash scripts/master.sh Demo demo --draft && bash scripts/contact-sheet.sh videos/demo/draft.mp4 src/compositions/demo.timeline.json",
    "render:hello": "remotion render Hello out/hello.mp4",
    "smoke": "bash scripts/smoke.sh",
    "catalog": "tsx scripts/build-catalog.ts",
    "catalog:previews": "bash scripts/catalog-previews.sh"
  },
  "dependencies": {
    "@remotion/captions": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
