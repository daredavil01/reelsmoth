{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelsmith.local/timeline.schema.json",
  "title": "Reelsmith timeline",
  "description": "Beats for one video. Scenes, audio and review all read this file; src/lib/timeline.ts validateTimeline() enforces the same rules at render time.",
  "type": "object",
  "required": ["fps", "width", "height", "beats"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "fps": {"type": "integer", "minimum": 1, "maximum": 120},
    "width": {"type": "integer", "minimum": 2, "multipleOf": 2, "description": "Even, for 4:2:0 encodes."},
    "height": {"type": "integer", "minimum": 2, "multipleOf": 2, "description": "Even, for 4:2:0 encodes."},
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "duration"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "start": {"type": "number", "minimum": 0, "description": "Seconds from the top of the video."},
          "duration": {"type": "number", "exclusiveMinimum": 0, "description": "Seconds."},
          "label": {"type": "string"},
          "hero": {"type": "boolean", "description": "The one hero moment. At most one beat; the music drop lands on its start."}
        }
      }
    }
  }
}
