{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelsmith.local/timeline.schema.json",
  "title": "Reelsmith timeline",
  "description": "Beats for one video. Scenes, audio and review all read this file; src/lib/timeline.ts validateTimeline() enforces the same rules at render time.",
  "type": "object",
  "required": [
    "fps",
    "width",
    "height",
    "beats"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "width": {
      "type": "integer",
      "minimum": 2,
      "multipleOf": 2,
      "description": "Even, for 4:2:0 encodes."
    },
    "height": {
      "type": "integer",
      "minimum": 2,
      "multipleOf": 2,
      "description": "Even, for 4:2:0 encodes."
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "duration"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds from the top of the video."
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Seconds."
          },
          "label": {
            "type": "string"
          },
          "hero": {
            "type": "boolean",
            "description": "The one hero moment. At most one beat; the music drop lands on its start."
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sound placed from beats. Written by scripts/find-drop.py --write and scripts/measure-peak.py --timeline; read by src/components/Soundtrack.tsx.",
      "properties": {
        "music": {
          "type": "object",
          "required": [
            "src",
            "dropAt"
          ],
          "additionalProperties": false,
          "properties": {
            "src": {
              "type": "string",
              "description": "Path under public/, e.g. audio/music/pulse-bed.wav"
            },
            "dropAt": {
              "type": "number",
              "minimum": 0,
              "description": "Seconds into the track where the drop is (scripts/find-drop.py)."
            },
            "dropOn": {
              "type": "string",
              "description": "Beat id the drop lands on. Default: the hero beat."
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.7
            },
            "fadeIn": {
              "type": "number",
              "minimum": 0,
              "default": 0.3
            },
            "fadeOut": {
              "type": "number",
              "minimum": 0,
              "default": 1.0
            },
            "duck": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "beat"
                ],
                "additionalProperties": false,
                "properties": {
                  "beat": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.65
                  }
                }
              },
              "description": "Dip the music under these beats (e.g. a voiceover line or the hero impact)."
            }
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "beat",
              "src"
            ],
            "additionalProperties": false,
            "properties": {
              "beat": {
                "type": "string"
              },
              "src": {
                "type": "string",
                "description": "Path under public/."
              },
              "anchor": {
                "enum": [
                  "start",
                  "end"
                ],
                "default": "start",
                "description": "Beat edge the cue is measured from."
              },
              "offset": {
                "type": "number",
                "default": 0,
                "description": "Seconds after the anchor where the sound's peak lands."
              },
              "peak": {
                "type": "number",
                "minimum": 0,
                "default": 0,
                "description": "Seconds into the file where it peaks (scripts/measure-peak.py)."
              },
              "gain": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.2,
                "description": "Hero hits 0.25-0.35, supporting 0.08-0.2."
              }
            }
          }
        }
      }
    }
  }
}
